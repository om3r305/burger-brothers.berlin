generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ─────────────────────────────────────────
 * TENANT
 * ─────────────────────────────────────────
 */
model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]
  campaigns Campaign[]
  settings  Setting[]
  coupons   Coupon[]
  orders    Order[]

  customers        Customer[]
  issuedCoupons    IssuedCoupon[]
  trackingSessions TrackingSession[]

  brianLearnLogs   BrianLearnLog[]
  brianRouteModels BrianRouteModel[]

  dailySalesSummaries   DailySalesSummary[]
  monthlySalesSummaries MonthlySalesSummary[]
  backupLogs            BackupLog[]
  cleanupJobLogs        CleanupJobLog[]

  pushSubscriptions     PushSubscription[]
  notificationPreferences NotificationPreference[]
  notificationCampaigns NotificationCampaign[]
  notificationEvents    NotificationEvent[]
  notificationDeliveries NotificationDelivery[]

  schnellRewardWins          SchnellRewardWin[]
  schnellWinnerSubmissions   SchnellWinnerSubmission[]
  showcaseLiveEvents         ShowcaseLiveEvent[]
  adminInboxNotifications    AdminInboxNotification[]
}

/**
 * ─────────────────────────────────────────
 * PRODUCT
 * ─────────────────────────────────────────
 */
model Product {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  sku         String
  name        String
  description String?
  imageUrl    String?
  category    String

  price Decimal @db.Decimal(10, 2)

  active     Boolean   @default(true)
  activeFrom DateTime?
  activeTo   DateTime?

  extrasJson Json?
  allergens  Json?

  order      Int?
  dailyLimit Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, sku])
  @@index([tenantId, category])
  @@index([tenantId, active])
  @@index([tenantId, activeFrom])
  @@index([tenantId, activeTo])
}

/**
 * ─────────────────────────────────────────
 * CAMPAIGN
 * ─────────────────────────────────────────
 */
model Campaign {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  code      String?
  title     String
  badgeText String?
  startsAt  DateTime?
  endsAt    DateTime?
  payload   Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code], map: "campaign_code_tenant_unique")
  @@index([tenantId, startsAt])
  @@index([tenantId, endsAt])
}

/**
 * ─────────────────────────────────────────
 * SETTING
 * ─────────────────────────────────────────
 */
model Setting {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  key   String
  value Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}

/**
 * ─────────────────────────────────────────
 * COUPON
 * ─────────────────────────────────────────
 */
model Coupon {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  code       String
  definition Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
}

/**
 * ─────────────────────────────────────────
 * ISSUED COUPON
 * ─────────────────────────────────────────
 */
model IssuedCoupon {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  couponId   String
  couponCode String
  code       String

  assignedToPhone String?
  assignedToEmail String?

  issuedAt  DateTime  @default(now())
  expiresAt DateTime?

  used   Boolean   @default(false)
  usedAt DateTime?

  source String?
  note   String?

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, couponId])
  @@index([tenantId, used])
}

/**
 * ─────────────────────────────────────────
 * CUSTOMER
 * ─────────────────────────────────────────
 */
model Customer {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name    String
  phone   String?
  email   String?
  address String?
  plz     String?
  notes   String?

  vip        Boolean @default(false)
  blocked    Boolean @default(false)
  emailOptIn Boolean @default(false)

  lastOrderAt DateTime?
  stats       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pushSubscriptions PushSubscription[]

  @@unique([tenantId, phone], map: "customer_phone_tenant_unique")
  @@index([tenantId])
  @@index([tenantId, lastOrderAt])
}

/**
 * ─────────────────────────────────────────
 * TRACKING SESSION
 * ─────────────────────────────────────────
 */
model TrackingSession {
  id       String @id
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  active   Boolean @default(true)
  driverId String?

  orderIds String[] @default([])

  last    Json?
  history Json?

  @@index([tenantId])
}

/**
 * ─────────────────────────────────────────
 * ORDER
 * ─────────────────────────────────────────
 */
model Order {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  mode    String
  channel String?

  status String

  merchandise    Decimal? @db.Decimal(10, 2)
  discount       Decimal? @db.Decimal(10, 2)
  surcharges     Decimal? @db.Decimal(10, 2)
  total          Decimal  @db.Decimal(10, 2)
  coupon         String?
  couponDiscount Decimal? @db.Decimal(10, 2)

  customer Json
  items    Json
  meta     Json?

  ts           DateTime @default(now())
  planned      String?
  etaMin       Int?
  etaAdjustMin Int?

  driver Json?

  doneAt      DateTime?
  cancelledAt DateTime?

  archivedAt   DateTime?
  anonymizedAt DateTime?

  history Json?
  print   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notificationEvents NotificationEvent[]
  schnellRewardWin   SchnellRewardWin?

  @@index([tenantId, status])
  @@index([tenantId, mode])
  @@index([tenantId, ts])
  @@index([tenantId, archivedAt])
  @@index([tenantId, anonymizedAt])
}

/**
 * ─────────────────────────────────────────
 * DAILY SALES SUMMARY
 * ─────────────────────────────────────────
 * Günlük rapor datası burada tutulur.
 * Eski siparişler arşive gitse bile günlük/yıllık raporlar buradan hızlı alınır.
 */
model DailySalesSummary {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  date DateTime

  orderCount     Int @default(0)
  pickupCount    Int @default(0)
  deliveryCount  Int @default(0)
  cancelledCount Int @default(0)

  grossSales      Decimal @default(0) @db.Decimal(10, 2)
  netSales        Decimal @default(0) @db.Decimal(10, 2)
  merchandise     Decimal @default(0) @db.Decimal(10, 2)
  discounts       Decimal @default(0) @db.Decimal(10, 2)
  surcharges      Decimal @default(0) @db.Decimal(10, 2)
  couponDiscounts Decimal @default(0) @db.Decimal(10, 2)

  cashTotal        Decimal @default(0) @db.Decimal(10, 2)
  onlineTotal      Decimal @default(0) @db.Decimal(10, 2)
  contactlessTotal Decimal @default(0) @db.Decimal(10, 2)
  splitTotal       Decimal @default(0) @db.Decimal(10, 2)

  topItems  Json?
  byHour    Json?
  byMode    Json?
  byPayment Json?
  extra     Json?

  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, date])
  @@index([tenantId])
  @@index([tenantId, date])
}

/**
 * ─────────────────────────────────────────
 * MONTHLY SALES SUMMARY
 * ─────────────────────────────────────────
 * Aylık/yıllık raporların hızlı çalışması için aylık özet.
 */
model MonthlySalesSummary {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  year  Int
  month Int

  orderCount     Int @default(0)
  pickupCount    Int @default(0)
  deliveryCount  Int @default(0)
  cancelledCount Int @default(0)

  grossSales      Decimal @default(0) @db.Decimal(10, 2)
  netSales        Decimal @default(0) @db.Decimal(10, 2)
  merchandise     Decimal @default(0) @db.Decimal(10, 2)
  discounts       Decimal @default(0) @db.Decimal(10, 2)
  surcharges      Decimal @default(0) @db.Decimal(10, 2)
  couponDiscounts Decimal @default(0) @db.Decimal(10, 2)

  cashTotal        Decimal @default(0) @db.Decimal(10, 2)
  onlineTotal      Decimal @default(0) @db.Decimal(10, 2)
  contactlessTotal Decimal @default(0) @db.Decimal(10, 2)
  splitTotal       Decimal @default(0) @db.Decimal(10, 2)

  topItems  Json?
  byDay     Json?
  byMode    Json?
  byPayment Json?
  extra     Json?

  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, year, month])
  @@index([tenantId])
  @@index([tenantId, year])
  @@index([tenantId, year, month])
}

/**
 * ─────────────────────────────────────────
 * BACKUP LOG
 * ─────────────────────────────────────────
 * Manuel veya otomatik backup/export kayıtları.
 * Dosyanın kendisini burada tutmak zorunda değiliz; metadata tutarız.
 */
model BackupLog {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type   String
  status String @default("success")

  fileName String?
  fileUrl  String?

  sizeBytes Int?
  checksum  String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  meta  Json?
  error String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, status])
  @@index([tenantId, startedAt])
}

/**
 * ─────────────────────────────────────────
 * CLEANUP JOB LOG
 * ─────────────────────────────────────────
 * Arşivleme, summary rebuild, eski log temizliği gibi işlemlerin kayıtları.
 */
model CleanupJobLog {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  jobType String
  status  String @default("success")

  affectedOrders    Int @default(0)
  affectedCustomers Int @default(0)
  affectedLogs      Int @default(0)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  meta  Json?
  error String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, jobType])
  @@index([tenantId, status])
  @@index([tenantId, startedAt])
}

/**
 * ─────────────────────────────────────────
 * BRIAN LEARN LOG
 * ─────────────────────────────────────────
 * Brian burada gerçek teslimat/rota öğrenme kayıtlarını tutar.
 * Local JSONL yerine DB-first kaynak bu tablodur.
 */
model BrianLearnLog {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  orderId String?

  driverId   String?
  driverName String?

  primaryStreet String?
  streets       Json
  peerStreets   Json?

  status String?
  source String?

  raw Json?

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, occurredAt])
  @@index([tenantId, orderId])
  @@index([tenantId, primaryStreet])
}

/**
 * ─────────────────────────────────────────
 * BRIAN ROUTE MODEL
 * ─────────────────────────────────────────
 * Brian export sonrası ürettiği aktif cluster/renk modelini burada saklar.
 * TV tarafı bu modelden okuyarak renkleri gösterir.
 */
model BrianRouteModel {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  key     String @default("current")
  version Int    @default(1)

  model Json
  stats Json?

  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([tenantId, generatedAt])
}

/**
 * ─────────────────────────────────────────
 * GENERAL WEB PUSH SUBSCRIPTION
 * ─────────────────────────────────────────
 * Android ve iOS ana ekran uygulamasındaki push aboneliği.
 * Endpoint veya anahtarlar hiçbir zaman müşteri arayüzünde tekrar gösterilmez.
 */
model PushSubscription {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  endpoint       String
  p256dh         String
  auth           String
  expirationTime DateTime?

  deviceTokenHash String
  deviceId        String?
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  phone     String?
  email     String?
  platform  String?
  userAgent String?
  locale    String @default("de")

  /// Only customer-installed Burger Brothers apps receive general notifications.
  /// Operational screens (TV, driver, admin, dashboard, visit, print) stay outside.
  appScope String @default("unknown")

  active        Boolean  @default(true)
  lastSeenAt    DateTime @default(now())
  lastPushAt    DateTime?
  lastSuccessAt DateTime?
  lastFailureAt DateTime?
  failureCount  Int      @default(0)

  preference NotificationPreference?
  events     NotificationEvent[]
  deliveries NotificationDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, endpoint])
  @@unique([tenantId, deviceTokenHash])
  @@index([tenantId, active])
  @@index([tenantId, appScope, active])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, customerId])
}

/**
 * Kullanıcı bildirim onayı. Tek ana onay mevcut bütün bildirim türlerini açar;
 * eski kategori alanları geriye uyumluluk ve ileride toplu kapatma için korunur.
 */
model NotificationPreference {
  id             String @id @default(cuid())
  tenantId       String
  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptionId String @unique
  subscription   PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  allNotifications Boolean @default(false)
  orderUpdates     Boolean @default(true)
  campaigns        Boolean @default(false)
  coupons          Boolean @default(false)
  nearbyDelivery   Boolean @default(false)

  consentVersion     String    @default("1")
  orderConsentedAt   DateTime?
  marketingConsentedAt DateTime?

  plz    String?
  street String?
  lat    Float?
  lng    Float?

  nearbyRadiusM      Int @default(800)
  nearbyCooldownDays Int @default(7)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, allNotifications])
  @@index([tenantId, campaigns])
  @@index([tenantId, coupons])
  @@index([tenantId, nearbyDelivery])
  @@index([tenantId, plz])
}

/** Admin tarafından hazırlanan kampanya/duyuru gönderimi. */
model NotificationCampaign {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  kind       String
  sourceKey  String?
  sourceHash String?
  title      String
  body       String
  url        String?
  imageUrl   String?
  audience   Json?
  metadata   Json?

  status         String   @default("draft")
  scheduledAt    DateTime?
  sentAt         DateTime?
  recipientCount Int      @default(0)
  successCount   Int      @default(0)
  failureCount   Int      @default(0)
  createdBy      String?

  events     NotificationEvent[]
  deliveries NotificationDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, sourceKey])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, scheduledAt])
  @@index([tenantId, kind, sourceKey])
}

/** Service Worker tarafından çekilecek tekil bildirim olayı. */
model NotificationEvent {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  subscriptionId String
  subscription   PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  campaignId String?
  campaign   NotificationCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  orderId String?
  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  type      String
  dedupeKey String?
  title     String
  body      String
  url       String?
  imageUrl  String?
  payload   Json?

  status      String   @default("queued")
  availableAt DateTime @default(now())
  expiresAt   DateTime?
  fetchedAt   DateTime?
  clickedAt   DateTime?

  deliveries NotificationDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, subscriptionId, status, availableAt])
  @@index([tenantId, orderId])
  @@index([tenantId, type, createdAt])
}

/** Push servisinin HTTP deneme ve sonuç kaydı. */
model NotificationDelivery {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  eventId String
  event   NotificationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  subscriptionId String
  subscription   PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  campaignId String?
  campaign   NotificationCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  status     String
  httpStatus Int?
  error      String?

  attemptedAt DateTime @default(now())
  deliveredAt DateTime?

  @@index([tenantId, status])
  @@index([tenantId, subscriptionId, attemptedAt])
  @@index([tenantId, campaignId])
}

/**
 * Schnellbestellung şanslı sipariş kazancı. Her sipariş ve günlük slot yalnızca bir kez kullanılabilir.
 */
model SchnellRewardWin {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  businessDate   String
  slotIndex      Int
  deviceTokenHash String?

  rewardType     String
  rewardCode     String
  rewardLabel    String
  rewardData     Json
  discountAmount Decimal @db.Decimal(10, 2)
  status         String  @default("won")

  submission SchnellWinnerSubmission?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, businessDate, slotIndex])
  @@index([tenantId, businessDate])
  @@index([tenantId, deviceTokenHash, businessDate])
}

/** Müşterinin isteğe bağlı isim/fotoğraf yayını. Fotoğraf kısa süreli private storage'da tutulur. */
model SchnellWinnerSubmission {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  rewardWinId String @unique
  rewardWin   SchnellRewardWin @relation(fields: [rewardWinId], references: [id], onDelete: Cascade)

  displayName      String
  moderationStatus String @default("pending")
  photoStatus       String @default("none")
  photoStoragePath  String?
  photoMimeType     String?
  photoSize         Int?

  consentVersion String?
  consentedAt    DateTime?
  expiresAt      DateTime
  deleteAfter    DateTime?
  publishedAt    DateTime?
  deletedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, moderationStatus, createdAt])
  @@index([tenantId, expiresAt])
  @@index([tenantId, deleteAfter])
}

/** Normal Showcase sahne döngüsünün üstünde kısa süreli oynatılan canlı olay. */
model ShowcaseLiveEvent {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  screenSlug String
  eventType  String
  sourceType String
  sourceId   String?
  payload    Json
  status     String @default("pending")

  scheduledAt DateTime @default(now())
  expiresAt   DateTime
  playedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, screenSlug, status, scheduledAt])
  @@index([tenantId, sourceType, sourceId])
  @@index([tenantId, expiresAt])
}

/** Admin panelindeki merkezi onay/bilgi kutusu. Müşteri push tablolarından ayrıdır. */
model AdminInboxNotification {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type       String
  title      String
  body       String
  url        String
  sourceType String
  sourceId   String
  dedupeKey  String
  status     String @default("unread")

  readAt     DateTime?
  resolvedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, sourceType, sourceId])
}

