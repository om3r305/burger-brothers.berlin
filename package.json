{
  "name": "burger-brothers-berlin",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "node server.js",
    "dev:next": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "npm run env:check -- --production && prisma migrate deploy && prisma generate && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:health": "ts-node tools/db_health.ts",
    "migrate:json": "ts-node tools/migrate_json_to_db.ts",
    "vercel:dev": "vercel dev",
    "prepush": "npm run typecheck && npm run build",
    "bootstrap": "curl -X POST http://localhost:3000/api/bootstrap -H \"Content-Type: application/json\" -d @bootstrap.json",
    "security:test": "node tools/security-tests.mjs && node tools/security-regression-tests.mjs && node tools/middleware-access-tests.cjs && node tools/release-security-tests.mjs && node tools/session-security-tests.cjs && node tools/tv-login-route-tests.cjs && node tools/driver-security-tests.cjs && node tools/order-pricing-tests.cjs && node tools/client-pricing-parity-tests.cjs && node tools/canonical-pricing-regression-tests.cjs && node tools/order-access-security-tests.cjs && node tools/order-role-route-tests.cjs && node tools/order-claim-route-tests.cjs && node tools/route-scope-security-tests.cjs && node tools/payment-closeout-tests.cjs && node tools/payment-center-architecture-tests.cjs && node tools/tracking-token-role-regression-tests.cjs && node tools/tv-refactor-regression-tests.cjs && node tools/checkout-safety-regression-tests.cjs",
    "security:audit": "npm audit --audit-level=high",
    "env:check": "node tools/validate-env.mjs",
    "artifact:check": "node tools/artifact-security-scan.mjs .",
    "hardening:test": "node tools/hardening-regression-tests.cjs",
    "performance:test": "node tools/operational-polling-regression-tests.cjs && node tools/menu-visual-stability-regression-tests.cjs",
    "transition:test": "node tools/menu-transition-regression-tests.cjs",
    "modal-swipe:test": "node tools/modal-swipe-regression-tests.cjs",
    "image-navigation:test": "node tools/image-navigation-regression-tests.cjs",
    "menu-visual-stability:test": "node tools/menu-visual-stability-regression-tests.cjs",
    "verify": "npm run env:check && npm run artifact:check && npm run typecheck && npm run hardening:test && npm run performance:test && npm run security:test && npm run showcase:test && npm run schnell:test && npm run notifications:test && npm run brian:test && npm run build",
    "pricing:test": "node tools/order-pricing-tests.cjs && node tools/client-pricing-parity-tests.cjs",
    "session:test": "node tools/session-security-tests.cjs",
    "driver-security:test": "node tools/driver-security-tests.cjs",
    "release:test": "node tools/release-security-tests.mjs",
    "secure:release": "powershell -ExecutionPolicy Bypass -File tools/create-secure-release.ps1",
    "tv:refactor:test": "node tools/tv-refactor-regression-tests.cjs",
    "showcase:test": "node tools/showcase-schedule-video-loop-tests.cjs && node tools/showcase-regression-tests.cjs && node tools/showcase-empty-text-regression-tests.cjs && node tools/showcase-final-hardening-regression-tests.cjs && node tools/showcase-final-v2-regression-tests.cjs && node tools/showcase-theme-v3-regression-tests.cjs && node tools/weather-winner-admin-performance-v4-regression-tests.cjs",
    "checkout:safety:test": "node tools/checkout-safety-regression-tests.cjs",
    "canonical:pricing:test": "node tools/canonical-pricing-regression-tests.cjs",
    "schnell:test": "node tools/schnellbestellung-regression-tests.cjs && node tools/schnell-black-angus-doneness-regression-tests.cjs",
    "schnell:vapid": "node tools/generate-schnell-vapid.mjs",
    "reward:audio": "node tools/generate-reward-stinger.cjs",
    "assets:webp": "node tools/generate-web-assets.cjs",
    "notifications:test": "node tools/general-notifications-regression-tests.cjs && node tools/nearby-delivery-matcher-tests.cjs && node tools/route-deal-lifecycle-regression-tests.cjs && node tools/nearby-push-campaign-create-regression-tests.cjs",
    "brian:test": "node tools/brian-export-regression-tests.cjs",
    "secrets:generate": "node tools/generate-production-secrets.mjs",
    "regression:test:all": "node tools/run-all-regression-checks.mjs"
  },
  "dependencies": {
    "@prisma/client": "7.10.0",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/supabase-js": "^2.112.4",
    "clsx": "2.1.1",
    "howler": "^2.2.4",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.38.0",
    "next": "16.3.3",
    "qr-scanner": "1.4.2",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-qr-code": "^2.2.0",
    "stripe": "^22.6.0",
    "three": "^0.185.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "autoprefixer": "10.4.19",
    "dotenv": "^17.4.2",
    "local-ssl-proxy": "^2.0.5",
    "postcss": "8.5.19",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.10",
    "ts-node": "^10.9.2",
    "typescript": "5.4.5"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "follow-redirects": "1.16.0",
    "minimatch": "10.2.6",
    "picomatch": "2.3.2",
    "uuid": "11.1.1",
    "yaml": "2.8.3",
    "glob": "11.1.0",
    "sharp": "0.35.3",
    "sucrase": "3.35.1",
    "three-mesh-bvh": "0.8.3",
    "defu": "6.1.7",
    "postcss": "$postcss"
  }
}
