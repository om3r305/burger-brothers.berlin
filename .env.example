# Burger Brothers Berlin — güvenli environment sözleşmesi
# Gerçek değerleri .env.local/Vercel Secret Store içine yazın. Bu dosyaya,
# GitHub'a veya teslim ZIP'ine hiçbir gerçek PIN/token koymayın.

# ── Zorunlu: PostgreSQL / tenant ─────────────────────────────────────────────
DATABASE_URL=
DIRECT_URL=
DEFAULT_TENANT_SLUG=burger-brothers
DEFAULT_TENANT_NAME=Burger Brothers Berlin
PRISMA_CONNECTION_LIMIT=5
PRISMA_CONNECT_TIMEOUT_SECONDS=10
PRISMA_POOL_TIMEOUT_SECONDS=15
PRISMA_POOL_DIAGNOSTICS=false

# ── Zorunlu: imzalı oturumlar ve yönetim ─────────────────────────────────────
# Secret/token değerleri en az 32 rastgele karakter; ADMIN_PASS en az 12
# karakter; TV_PIN yalnız rakam ve 6-12 hane olmalıdır.
SESSION_SECRET=
ADMIN_USER=
ADMIN_PASS=
TV_PIN=
ADMIN_TOTP_SECRET=
SESSION_VERSION=1
ADMIN_SESSION_VERSION=1
TV_SESSION_VERSION=1
DRIVER_SESSION_VERSION=1
ADMIN_COOKIE_NAME=bb_admin_auth
TV_COOKIE_NAME=bb_tv_auth

# ── Zorunlu: sunucudan sunucuya işler ────────────────────────────────────────
BOOTSTRAP_MIGRATION_TOKEN=
CRON_SECRET=
ANALYTICS_IP_SECRET=
ANALYTICS_RETENTION_DAYS=30

# ── Zorunlu production hukuki kimlik ────────────────────────────────────────
LEGAL_OPERATOR_NAME=
LEGAL_RESPONSIBLE_NAME=
LEGAL_PRIVACY_EMAIL=contact@burgerbrothers.berlin
LEGAL_VAT_ID=
LEGAL_REGISTER_ENTRY=

# ── Zorunlu production mali sınır kararı ────────────────────────────────────
# external_certified_pos: bu uygulama mutfak/sipariş belgesi basar; her işlem
# ayrıca sertifikalı kasaya girilir. webshop_only: yerinde elektronik kasa
# fonksiyonu yoktur. Bu karar mali müşavirle doğrulanmalıdır.
FISCAL_OPERATION_MODE=
FISCAL_POS_NAME=

# ── Zorunlu (production/serverless): dağıtılmış rate limit ───────────────────
RATE_LIMIT_REQUIRE_REMOTE=1
RATE_LIMIT_FAIL_CLOSED=1
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Alternatif sağlayıcı adları:
RATE_LIMIT_REST_URL=
RATE_LIMIT_REST_TOKEN=
RATE_LIMIT_LOCAL_MAX_KEYS=5000
RATE_LIMIT_LOCAL_SWEEP_INTERVAL=100

# ── Stripe (online ödeme açıksa dört değer birlikte zorunlu) ─────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PUBLISHABLE_KEY=

# ── Site URL'leri ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://www.burger-brothers.berlin
NEXT_PUBLIC_SITE_URL=https://www.burger-brothers.berlin
SITE_URL=https://www.burger-brothers.berlin
APP_URL=https://www.burger-brothers.berlin
BASE_URL=https://www.burger-brothers.berlin

# ── Yerel yazdırma: agent + loopback proxy ───────────────────────────────────
PRINT_AGENT_TOKEN=
PRINT_PROXY_TOKEN=
PRINT_PROXY_HOST=127.0.0.1
PRINT_PROXY_URL=http://127.0.0.1:17321
NEXT_PUBLIC_PRINT_PROXY_URL=http://127.0.0.1:17321
PRINT_CORS_ORIGINS=https://www.burger-brothers.berlin
PRINT_TEST_ENABLED=false
PRINT_TEST_ALLOWED_PROXY_ORIGINS=
PRINT_TEST_ALLOW_PROXY_OVERRIDE=false
PRINT_TEST_ALLOW_ANY_PRINTER_IP=false
PRINT_FETCH_TIMEOUT_MS=10000
PRINT_SOCKET_TIMEOUT_MS=10000
MAX_JSON_BYTES=262144
MAX_PRINT_COPIES=3
MAX_PRINT_LINES=200
MAX_PRINT_LINE_CHARS=240
PRINT_ALLOW_LEGACY_TAX_FALLBACK=0
MAX_LOGO_BYTES=3145728
LOGO_URL_ORIGINS=https://www.burger-brothers.berlin

# Agent/printer makinesine özgü değerler:
PRINT_AGENT_CONFIG=./print-agent/config.json
PRINT_AGENT_NAME=burger-kitchen
PRINT_AGENT_AUTO_PRINT=false
PRINT_POLL_SECONDS=3
PRINT_LEASE_SECONDS=90
PRINT_MAX_JOBS=20
PRINT_MAX_ATTEMPTS=5
PRINT_LOOKBACK_MINUTES=1440
PRINT_PRINTER_IP=
PRINT_PRINTER_PORT=9100
PRINTER_IP=
PRINTER_PORT=9100
PRINTER_NAME=

# ── Şifreli günlük backup + veri yaşam döngüsü ───────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BACKUP_BUCKET=bb-backups
BACKUP_RETENTION_DAYS=30
# openssl rand -base64 32 (32 byte; yalnız secret store'da tutulur)
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY_ID=primary
ORDER_PII_RETENTION_DAYS=90
CUSTOMER_PII_RETENTION_DAYS=365
PII_CLEANUP_BATCH_SIZE=250
TRACKING_PUBLIC_TTL_HOURS=72
TRACKING_RETENTION_DAYS=7
ALLOW_LEGACY_TRACKING_QUERY_TOKEN=0

# ── Reward/showcase medya (Cloudinary veya R2) ───────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SHOWCASE_FOLDER=burger-brothers/showcase
CLOUDINARY_MAX_UPLOAD_MB=8
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_MAX_UPLOAD_MB=8

# ── Telegram (opsiyonel; etkinse token + chat birlikte) ──────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ORDER_CHAT_ID=
TELEGRAM_ADMIN_CHAT_ID=

# ── Schnellbestellung konum doğrulaması ─────────────────────────────────────
SCHNELLBESTELLUNG_SHOP_LAT=
SCHNELLBESTELLUNG_SHOP_LNG=

# ── Web push / diğer opsiyonel entegrasyonlar ────────────────────────────────
GENERAL_PUSH_ENABLED=false
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=
GOOGLE_BUSINESS_ACCESS_TOKEN=

# ── Kontrollü fallback snapshot storage (opsiyonel) ──────────────────────────
# Production'da yerel disk yerine uzak KV kullanın.
FALLBACK_KV_REST_URL=
FALLBACK_KV_REST_TOKEN=
FALLBACK_SNAPSHOT_NAMESPACE=burger-brothers
