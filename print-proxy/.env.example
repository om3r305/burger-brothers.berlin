# Yerel yazici proxy ayarlari. Bu dosyayi .env olarak kopyalayip degerleri duzenleyin.
PORT=7777
PRINT_PROXY_HOST=127.0.0.1
PRINTER_IP=192.168.0.150
PRINTER_PORT=9100

# En az 32 karakterlik rastgele bir deger kullanin.
# Vercel PRINT_PROXY_TOKEN ve print-agent printProxyToken degeriyle ayni olmali.
PRINT_PROXY_TOKEN=BURAYA_UZUN_RASTGELE_TOKEN

ALLOW_ORIGINS=https://www.burger-brothers.berlin,http://127.0.0.1,http://localhost
MAX_JSON_BYTES=262144
MAX_PRINT_COPIES=3
MAX_PRINT_LINES=200
MAX_PRINT_LINE_CHARS=240
PRINT_ALLOW_LEGACY_TAX_FALLBACK=0
FISCAL_OPERATION_MODE=external_certified_pos

# Fiş başlığı; başlangıçta bir kez okunur, her baskıda ek istek oluşturmaz.
PRINT_STORE_ADDRESS_LINE_1=Berliner Str. 9
PRINT_STORE_ADDRESS_LINE_2=13507 Berlin
PRINT_STORE_PHONE=Tel: 030 - 405 73 030
PRINT_STORE_TAX_ID=St.Nr: 17/602/03138

LOGO_URL=https://www.burger-brothers.berlin/logo-thermal.bmp
LOGO_URL_ORIGINS=https://www.burger-brothers.berlin
MAX_LOGO_BYTES=3000000
ALLOW_INSECURE_LOGO=0
